[Unit]
Description=demo9 T113 远程控制中继服务器
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/server
ExecStart=/opt/server/venv/bin/python -u /opt/server/server.py --host 0.0.0.0 --port 9000 --token t113demo
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
